{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "gestion-commandes",
    "Audience": "gestion-commandes-api",
    "AccessTokenMinutes": 120
  },
  "Gateway": {
    "RequestsPerMinute": 300
  },
  "Services": {
    "Identity": "http://identity-service:8080",
    "Catalog": "http://catalog-service:8080",
    "Order": "http://order-service:8080",
    "Delivery": "http://delivery-service:8080"
  }
}
