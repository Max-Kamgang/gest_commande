    <AssemblyName>GestionCommandes.NotificationService</AssemblyName>
    <!-- Nom technique du service, utilise pour les logs, la base et Swagger -->
    <ServiceName>notification-service</ServiceName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks\GestionCommandes.BuildingBlocks.csproj" />
  </ItemGroup>

</Project>
