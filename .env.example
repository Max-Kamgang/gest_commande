# ============================================================================
#  Gestion des commandes, du stock et des livraisons - configuration du serveur
#  Copier ce fichier en « .env » (non versionne) et adapter les valeurs.
#  Ne JAMAIS commiter le fichier .env : il contient les secrets.
# ============================================================================

# --- Secrets ---------------------------------------------------------------
# Cle de signature des jetons JWT (HMAC-SHA256). 32 caracteres minimum.
# Generer une valeur : [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
JWT_KEY=CHANGEZ-MOI-cle-jwt-au-moins-32-caracteres-aleatoires

# Cle partagee entre microservices (appels de service a service). Jamais exposee par la gateway.
INTERNAL_API_KEY=CHANGEZ-MOI-cle-interne-aleatoire

# Mot de passe du certificat .pfx de la gateway (genere par infra/06-generate-cert.ps1).
CERT_PASSWORD=CHANGEZ-MOI-mot-de-passe-pfx

# --- Chemins sur le serveur (un seul disque C: : tout est sous C:\microservices) -----
# Racine des donnees persistantes : un sous-dossier par service (base SQLite + logs).
MICRO_DATA_ROOT=C:\microservices\data
# Certificats de la gateway (gateway.pfx) montes en lecture seule.
MICRO_CERTS_DIR=C:\microservices\certs

# --- Ports publies sur l'hote ----------------------------------------------
# Seule la gateway est publiee. Les services restent sur le reseau interne Docker.
HTTP_PORT=80
HTTPS_PORT=443

# --- Images de base (parametrables) ----------------------------------------
# Tags nanoserver LTSC 2025 : meme famille que l'hote Windows Server 2025.
SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0-nanoserver-ltsc2025
RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0-nanoserver-ltsc2025

# --- Comportement --------------------------------------------------------
# Niveau de journalisation applicatif (Information, Warning...).
SERILOG_LEVEL=Information
