# ============================================================================
#  Configuration du deploiement. Copier ce fichier en « .env » et renseigner
#  les deux secrets. Le fichier .env n'est JAMAIS versionne.
#
#      Copy-Item .env.example .env
# ============================================================================

# --- Secrets (obligatoires) -------------------------------------------------
# Cle de signature des jetons JWT, 32 caracteres minimum. Pour en generer une :
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_KEY=CHANGEZ-MOI-cle-jwt-de-32-caracteres-minimum

# Cle partagee pour les appels entre conteneurs. Jamais exposee a l'exterieur :
# la gateway supprime cet en-tete des requetes entrantes.
INTERNAL_API_KEY=CHANGEZ-MOI-cle-interne-aleatoire

# --- Chemins sur le serveur -------------------------------------------------
# Racine des donnees persistantes : un sous-dossier par service (base SQLite).
# Le script deploy\1-setup-serveur.ps1 cree ces dossiers.
MICRO_DATA_ROOT=C:\microservices\data

# --- Port publie ------------------------------------------------------------
# Seule la gateway est publiee. 80 par defaut ; mettre 8080 si IIS occupe le 80.
HTTP_PORT=80

# --- Images de base ---------------------------------------------------------
# Les tags nanoserver doivent correspondre a la version de l'hote Windows :
#   Windows Server 2025 -> ltsc2025      Windows Server 2022 -> ltsc2022
SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0-nanoserver-ltsc2025
RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0-nanoserver-ltsc2025
